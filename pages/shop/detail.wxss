.detail-page { padding-bottom: 182rpx; }
.detail-visual { position: relative; height: 500rpx; border-radius: 30rpx; box-shadow: 0 18rpx 42rpx rgba(24,52,48,.1); }
.detail-visual image { display: block; width: 100%; height: 100%; }
.detail-badge { position: absolute; top: 24rpx; left: 24rpx; padding: 8rpx 14rpx; border: 1rpx solid rgba(255,255,255,.58); border-radius: 12rpx; background: rgba(255,255,255,.82); color: #396760; font-size: 20rpx; }
.detail-visual-meta { position: absolute; right: 24rpx; bottom: 22rpx; left: 24rpx; display: flex; justify-content: space-between; color: rgba(21,69,64,.64); font-size: 16rpx; font-weight: 700; letter-spacing: 2rpx; }
.detail-card { position: relative; z-index: 1; margin-top: -42rpx; padding: 30rpx 28rpx 26rpx; }
.detail-card-top { display: flex; align-items: flex-start; justify-content: space-between; }
.detail-card-top > view { display: flex; flex: 1; flex-direction: column; }
.detail-title { color: #172322; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 35rpx; font-weight: 700; }
.detail-subtitle { margin-top: 10rpx; color: #728580; font-size: 23rpx; }
.detail-share { flex: none; padding: 9rpx 12rpx; border-radius: 12rpx; background: #f1f7f5; color: #3b8178; font-size: 19rpx; }
.detail-price-line { display: flex; align-items: baseline; margin-top: 24rpx; }
.detail-price { color: #bd6a28; font-size: 46rpx; font-weight: 700; }
.detail-original { margin-left: 12rpx; color: #a8b5b1; font-size: 22rpx; text-decoration: line-through; }
.detail-unit { margin-left: auto; color: #7d8e89; font-size: 21rpx; }
.detail-rule-line { display: flex; justify-content: space-between; margin-top: 15rpx; color: #9aa9a5; font-size: 20rpx; }
.detail-trust { display: flex; justify-content: space-between; margin: 22rpx 4rpx 0; padding: 17rpx 16rpx; border: 1rpx solid #e3ebe8; border-radius: 18rpx; background: #fbfdfc; color: #72847f; font-size: 20rpx; }
.detail-trust view { display: flex; align-items: center; }
.trust-icon { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-right: 8rpx; border-radius: 11rpx; background: #e4f3ef; color: #0d7f75; font-size: 18rpx; font-weight: 700; }
.detail-trust view:nth-child(2) .trust-icon { background: #fff0dc; color: #bd6a28; }
.detail-trust view:nth-child(3) .trust-icon { background: #eee6f4; color: #725481; }
.detail-section { margin-top: 22rpx; padding: 28rpx; }
.detail-section-head { display: flex; align-items: baseline; justify-content: space-between; }
.detail-section-title { color: #1f302d; font-size: 29rpx; font-weight: 700; }
.detail-section-caption { color: #a1afab; font-size: 16rpx; letter-spacing: 2rpx; }
.detail-description { display: block; margin-top: 16rpx; color: #657873; font-size: 25rpx; line-height: 1.75; }
.detail-disclaimer { display: block; margin-top: 17rpx; color: #b36c32; font-size: 21rpx; line-height: 1.55; }
.sku-panel { margin-top: 22rpx; padding: 28rpx; }
.sku-list { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.sku-option { display: flex; align-items: center; justify-content: space-between; min-width: 260rpx; padding: 18rpx 20rpx; border: 2rpx solid #dce8e4; border-radius: 14rpx; color: #536b65; font-size: 23rpx; }
.sku-option.active { border-color: #0d7f75; background: #e4f3ef; color: #075c57; }
.prescription-panel { margin-top: 22rpx; padding: 25rpx 28rpx; border: 2rpx solid #cfe6df; border-radius: 24rpx; background: #eff8f5; }
.prescription-panel__head { display: flex; align-items: center; }
.prescription-mark { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; margin-right: 12rpx; border-radius: 14rpx; background: #0d7f75; color: #fff; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 24rpx; font-weight: 700; }
.prescription-panel__title { color: #175d56; font-size: 28rpx; font-weight: 700; }
.prescription-panel__status { margin-left: auto; padding: 7rpx 10rpx; border-radius: 9rpx; background: #d8eee8; color: #257c71; font-size: 19rpx; }
.prescription-panel__text { display: block; margin-top: 15rpx; color: #52716b; font-size: 22rpx; line-height: 1.55; }
.prescription-link { display: block; margin-top: 17rpx; color: #0d7f75; font-size: 22rpx; font-weight: 700; }
.quantity-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.quantity-row > view:first-child { display: flex; flex-direction: column; }
.quantity-label { color: #263a36; font-size: 27rpx; font-weight: 700; }
.quantity-hint { margin-top: 7rpx; color: #9aa9a5; font-size: 19rpx; }
.stepper { display: flex; align-items: center; height: 68rpx; overflow: hidden; border: 2rpx solid #dce8e4; border-radius: 17rpx; background: #ffffff; }
.stepper-button, .stepper-number { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 68rpx; color: #41615b; font-size: 31rpx; }
.stepper-number { border-right: 1rpx solid #e6efec; border-left: 1rpx solid #e6efec; font-size: 24rpx; }
.bottom-actions { position: fixed; right: 22rpx; bottom: 22rpx; left: 22rpx; z-index: 10; display: flex; align-items: center; gap: 12rpx; padding: 14rpx; border: 1rpx solid rgba(217,230,226,.95); border-radius: 25rpx; background: rgba(255,255,255,.96); box-shadow: 0 -12rpx 34rpx rgba(24,52,48,.12); }
.bottom-mini { display: flex; align-items: center; flex-direction: column; justify-content: center; width: 72rpx; color: #66807a; font-size: 17rpx; }
.bottom-mini-icon { display: flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; margin-bottom: 4rpx; border-radius: 14rpx; background: #eef8f5; color: #0d7f75; font-size: 19rpx; font-weight: 700; }
.bottom-cart, .bottom-buy { flex: 1; min-height: 82rpx; font-size: 25rpx; }
