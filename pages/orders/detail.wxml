<view wx:if="{{loading}}" class="page-shell"><view class="surface empty-state"><text>正在加载订单</text></view></view>
<view wx:elif="{{errorMessage}}" class="page-shell"><view class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view></view>
<view class="page-shell order-detail-page" wx:elif="{{order}}">
  <view class="status-hero"><view class="status-hero-orbit">九转</view><view><text class="status-label">{{order.statusText}}</text><text class="status-hint">订单号 {{order.orderNo}}</text></view></view>
  <view class="status-steps"><view class="status-step active"><text>1</text><label>下单</label></view><view class="status-line {{order.status !== 'pending_payment' ? 'active' : ''}}"></view><view class="status-step {{order.status !== 'pending_payment' ? 'active' : ''}}"><text>2</text><label>支付</label></view><view class="status-line {{order.status === 'shipped' || order.status === 'completed' ? 'active' : ''}}"></view><view class="status-step {{order.status === 'shipped' || order.status === 'completed' ? 'active' : ''}}"><text>3</text><label>收货</label></view></view>
  <view class="surface shipment-card"><text class="block-title">配送信息</text><view wx:if="{{order.shipment}}" class="shipment-detail"><view><text class="shipment-carrier">{{order.shipment.carrier}}</text><text class="muted">物流单号 {{order.shipment.trackingNo}}</text></view><text class="shipment-status">{{order.shipment.status}}</text></view><view wx:elif="{{order.logistics && order.logistics.nodes && order.logistics.nodes.length}}" class="shipment-detail"><view><text class="shipment-carrier">物流动态</text><text class="muted">{{order.logistics.nodes[0].description || order.logistics.nodes[0].status}}</text></view><text class="shipment-status">{{order.logistics.status}}</text></view><text wx:else class="shipment-copy">{{order.status === 'pending_payment' ? '支付完成后，发货员会在后台处理发货。' : '物流信息将在后台填写快递公司和单号后展示。'}}</text></view>
  <view class="surface detail-items"><view class="detail-section-head"><text class="block-title">商品清单</text><text class="muted">{{order.items.length}} 件</text></view><view wx:for="{{order.items}}" wx:key="cartKey" class="detail-item"><view class="detail-thumb image-frame" style="background: {{item.color}};"><image wx:if="{{item.image}}" class="product-art" src="{{item.image}}" mode="aspectFit" /><image wx:if="{{item.overlay}}" class="product-overlay" src="{{item.overlay}}" mode="scaleToFill" /><view wx:if="{{!item.image}}" class="product-fallback {{item.category}}"><text class="product-fallback__mark">{{item.category === 'prescription' ? '处' : '养'}}</text></view></view><view class="detail-item-copy"><text>{{item.name}}</text><text class="muted">{{item.skuName || item.unit || '默认规格'}} · ×{{item.quantity}} · ¥{{item.unitPriceText || item.unitPrice}}</text></view><text class="detail-item-price">¥{{item.lineTotalText}}</text></view></view>
  <view class="surface address-card"><text class="block-title">收货地址</text><text wx:if="{{order.address}}" class="address-copy">{{order.address.name}} {{order.address.phone}}</text><text wx:if="{{order.address}}" class="muted address-detail">{{order.address.detail}}</text><text wx:else class="muted address-detail">暂无收货地址</text></view>
  <view class="surface amount-card"><view class="amount-line"><text>商品小计</text><text>¥{{order.subtotalText}}</text></view><view class="amount-line"><text>运费</text><text>{{order.freightText}}</text></view><view class="amount-total"><text>实付</text><text>¥{{order.totalText}}</text></view></view>
  <view class="action-row"><view wx:if="{{order.status === 'pending_payment'}}" class="secondary-button action-button" bindtap="cancel">取消订单</view><view wx:if="{{order.status === 'pending_payment'}}" class="primary-button action-button" bindtap="pay">立即支付</view><view wx:if="{{order.status === 'shipped'}}" class="primary-button action-button" bindtap="receive">确认收货</view><view wx:if="{{order.status === 'completed'}}" class="secondary-button action-button" bindtap="aftersale">申请售后</view><view wx:if="{{order.status === 'completed'}}" class="secondary-button action-button" bindtap="invoice">申请发票</view></view>
  <view wx:if="{{aftersales.length || invoices.length}}" class="surface status-records"><text class="block-title">售后与发票记录</text><view wx:for="{{aftersales}}" wx:key="id"><text>售后：{{item.statusText || item.status}}</text></view><view wx:for="{{invoices}}" wx:key="id"><text>发票：{{item.statusText || item.status}}</text></view></view>
</view>

