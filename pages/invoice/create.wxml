<view class="page-shell invoice-page"><view class="page-heading"><text class="eyebrow">电子发票</text><text class="page-title">申请电子发票</text><text class="page-subtitle">订单：{{orderId}} · 确认收货后可申请普通电子发票。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在提交开票申请</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="submit">重新提交</view></view><view wx:elif="{{submitted}}" class="surface done-card"><text class="done-mark">✓</text><text class="done-title">发票申请已提交</text><text class="done-copy">当前状态：{{result.statusText || result.status || '待开票'}}。财务处理完成后可在订单中查看。</text><view class="secondary-button done-button" bindtap="back">返回订单</view></view><view wx:else class="surface form-card"><text class="field-label">发票类型</text><radio-group bindchange="typeChange"><label class="radio-label"><radio value="0" checked="{{type === '个人'}}" color="#0F766E" />个人</label><label class="radio-label"><radio value="1" checked="{{type === '企业'}}" color="#0F766E" />企业</label></radio-group><text class="field-label">发票抬头</text><input class="form-input" value="{{title}}" data-field="title" bindinput="input" placeholder="请输入发票抬头" /><view wx:if="{{type === '企业'}}"><text class="field-label">税号</text><input class="form-input" value="{{taxNo}}" data-field="taxNo" bindinput="input" placeholder="请输入纳税人识别号" /></view><view class="primary-button submit-button" bindtap="submit">提交开票申请</view></view></view>

