.invoice-page { padding-bottom: 56rpx; }
.page-heading { margin-bottom: 28rpx; }
.eyebrow { display: block; color: #0f766e; font-size: 19rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 8rpx; color: #111827; font-size: 42rpx; font-weight: 700; }
.page-subtitle { display: block; margin-top: 14rpx; color: #64748b; font-size: 23rpx; line-height: 1.5; }
.form-card { padding: 30rpx; }
.field-label { display: block; margin-top: 24rpx; color: #334155; font-size: 25rpx; font-weight: 700; }
.field-label:first-child { margin-top: 0; }
.radio-label { display: inline-flex; align-items: center; margin-top: 16rpx; margin-right: 34rpx; color: #334155; font-size: 25rpx; }
.form-input { width: 100%; height: 78rpx; margin-top: 12rpx; padding: 0 20rpx; border: 2rpx solid #e4ecec; border-radius: 14rpx; color: #1f2937; font-size: 25rpx; }
.submit-button { margin-top: 30rpx; }
.done-card { display: flex; align-items: center; flex-direction: column; padding: 52rpx 30rpx; text-align: center; }
.done-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 50%; background: #dff4ee; color: #0f766e; font-size: 54rpx; }
.done-title { margin-top: 24rpx; color: #1f2937; font-size: 32rpx; font-weight: 700; }
.done-copy { margin-top: 16rpx; color: #64748b; font-size: 24rpx; line-height: 1.6; }
.done-button { width: 100%; margin-top: 30rpx; }
