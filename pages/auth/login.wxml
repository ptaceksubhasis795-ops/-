<view class="page-shell login-page"><view class="login-brand"><view class="login-mark">九</view><text class="login-title">九转健康商城</text><text class="login-subtitle">商品、处方与健康服务，一处管理</text></view><view class="surface login-card"><view wx:if="{{!loggedIn}}"><text wx:if="{{runtime.environment !== 'production'}}" class="field-label">手机号（开发环境可手动填写）</text><input wx:if="{{runtime.environment !== 'production'}}" class="login-input" type="number" value="{{phone}}" bindinput="input" placeholder="请输入手机号" /></view><view wx:else><text class="field-label">绑定手机号</text><button class="secondary-button login-button" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">{{phoneLoading ? '正在绑定…' : '授权微信手机号'}}</button></view><view class="login-agreement"><text class="agreement-check">✓</text><text>登录即代表同意隐私政策和健康信息授权说明</text></view><view wx:if="{{!loggedIn}}" class="primary-button login-button" bindtap="login">{{loading ? '正在登录…' : '微信一键登录'}}</view></view></view>
