<view class="page-shell member-page"><view class="page-heading"><text class="eyebrow">会员计划</text><text class="page-title">成为会员</text><text class="page-subtitle">分享健康内容和商品，查看直接客户与奖励明细。</text></view><view class="member-benefits"><view><text class="benefit-icon">客</text><text>客户归属</text></view><view><text class="benefit-icon">奖</text><text>奖励明细</text></view><view><text class="benefit-icon">享</text><text>专属素材</text></view></view><view wx:if="{{referrerPromoterId}}" class="surface referrer-note"><text>当前推广来源已记录：{{referrerPromoterId}}</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载申请状态</text></view><view wx:elif="{{errorMessage && authRequired}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="onShow">重新加载</view></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="onShow">重新加载</view></view><view wx:elif="{{application}}" class="surface application-card {{application.status}}"><text class="application-mark">{{application.status === 'approved' ? '✓' : application.status === 'rejected' ? '!' : '…'}}</text><text class="application-title">会员申请：{{application.statusText}}</text><text class="application-copy">{{application.statusHint}}</text><view class="application-meta"><text>申请来源：{{application.sourceText}}</text><text>推荐人：{{application.recommender || '无'}}</text><text>归属销售人员：{{application.salesText}}</text></view><view wx:if="{{application.status === 'approved'}}" class="application-actions"><view class="secondary-button application-button" bindtap="network">查看我的关系</view><view class="primary-button application-button" bindtap="sales">查看销售中心</view></view><view wx:elif="{{application.canReapply}}" class="primary-button application-button" bindtap="submit">重新申请</view></view><view wx:else class="surface member-form"><text class="field-label">姓名</text><input class="form-input" data-field="name" value="{{name}}" bindinput="input" placeholder="请输入真实姓名" /><text class="field-label">手机号</text><input class="form-input" data-field="phone" value="{{phone}}" bindinput="input" type="number" placeholder="请输入手机号" /><text class="field-label">推荐人</text><input class="form-input" data-field="recommender" value="{{recommender}}" bindinput="input" placeholder="选填，可填写推广码或姓名" /><view class="agreement"><text class="agreement-mark">✓</text><text>我同意将申请信息用于会员审核和推广关系建立。</text></view><view class="primary-button member-submit" bindtap="submit">{{submitting ? '正在提交…' : '提交会员申请 →'}}</view></view></view>
