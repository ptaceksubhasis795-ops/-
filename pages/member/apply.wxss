.member-page { padding-bottom: 64rpx; }
.page-heading { margin-bottom: 28rpx; }
.eyebrow { display: block; color: #0f766e; font-size: 19rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 8rpx; color: #111827; font-size: 42rpx; font-weight: 700; }
.page-subtitle { display: block; margin-top: 14rpx; color: #64748b; font-size: 23rpx; line-height: 1.5; }
.member-benefits { display: flex; justify-content: space-between; margin-bottom: 18rpx; padding: 18rpx 20rpx; border: 1rpx solid #e1ebe8; border-radius: 22rpx; background: #ffffff; color: #60736e; font-size: 20rpx; }
.member-benefits view { display: flex; align-items: center; }
.benefit-icon { display: flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; margin-right: 8rpx; border-radius: 14rpx; background: #edf8f5; color: #0d7f75; font-size: 20rpx; font-weight: 700; }
.member-benefits view:nth-child(2) .benefit-icon { background: #fff5e8; color: #b7682e; }
.member-benefits view:nth-child(3) .benefit-icon { background: #f5eff8; color: #725481; }
.member-form { padding: 30rpx; }
.field-label { display: block; margin-top: 24rpx; color: #334155; font-size: 25rpx; font-weight: 700; }
.field-label:first-child { margin-top: 0; }
.form-input { width: 100%; height: 78rpx; margin-top: 12rpx; padding: 0 20rpx; border: 2rpx solid #e4ecec; border-radius: 14rpx; color: #1f2937; font-size: 25rpx; }
.agreement { display: flex; align-items: flex-start; margin-top: 26rpx; color: #64748b; font-size: 21rpx; line-height: 1.5; }
.agreement-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 30rpx; height: 30rpx; margin-right: 10rpx; border-radius: 8rpx; background: #0f766e; color: #fff; font-size: 20rpx; }
.member-submit { margin-top: 24rpx; }
.application-card { display: flex; align-items: center; flex-direction: column; padding: 52rpx 30rpx; text-align: center; }
.application-mark { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; border-radius: 50%; background: #dff4ee; color: #0f766e; font-size: 54rpx; }
.application-title { margin-top: 24rpx; color: #1f2937; font-size: 32rpx; font-weight: 700; }
.application-copy { margin-top: 16rpx; color: #64748b; font-size: 24rpx; line-height: 1.6; }
.application-button { width: 100%; margin-top: 30rpx; }
.application-card.approved { border-color: #c9e8dc; }
.application-card.rejected { border-color: #f2d1cc; }
.application-card.pending { border-color: #d8e7e2; }
.application-actions { display: flex; gap: 14rpx; width: 100%; }
.application-actions .application-button { flex: 1; }
.application-meta { display: flex; align-items: center; flex-direction: column; gap: 8rpx; width: 100%; margin-top: 22rpx; color: #71827e; font-size: 22rpx; line-height: 1.5; }
.empty-button { width: 230rpx; min-height: 76rpx; margin-top: 28rpx; font-size: 25rpx; }
