.promotion-summary,.promotion-months{margin-bottom:20rpx;padding:28rpx}.summary-line{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.card-label,.section-heading__title{display:block;color:#6c8f89;font-size:24rpx}.card-title{display:block;margin:12rpx 0 6rpx;color:#1d4b47;font-size:44rpx;font-weight:600}.eligibility-badge,.status-pill{display:inline-flex;align-items:center;padding:9rpx 15rpx;border-radius:18rpx;background:#fff5e8;color:#a55f2a;font-size:21rpx;white-space:nowrap}.eligibility-badge.success,.status-pill.approved{background:#e3f5ef;color:#0f766e}.eligibility-badge.muted-badge,.status-pill.pending{background:#eef3f2;color:#60736e}.status-pill.rejected{background:#fcebea;color:#b44f45}.criteria-line{display:flex;justify-content:space-between;gap:20rpx;margin-top:23rpx;padding-top:20rpx;border-top:1rpx solid #e5efec;color:#315a55;font-size:23rpx}.criteria-line text:last-child{flex:1;color:#6c8781;text-align:right}.gap-hint{display:block;margin-top:13rpx;color:#b7682e;font-size:21rpx}.section-heading-inline{display:flex;align-items:center;justify-content:space-between;margin-bottom:4rpx}.month-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #e5efec;color:#315a55;font-size:28rpx}.month-row:last-child{border-bottom:0}.month-row>view:first-child{display:flex;flex-direction:column;gap:6rpx}.month-amount{display:flex;align-items:flex-end;flex-direction:column;gap:5rpx}.month-amount .muted{color:#b7682e}.application-card{margin-top:20rpx;padding:28rpx}.application-card.approved{border-color:#c9e8dc}.application-card.rejected{border-color:#f2d1cc}.application-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.application-title{display:block;color:#1d4b47;font-size:30rpx;font-weight:600}.application-copy{display:block;margin-top:15rpx;color:#6c8781;font-size:25rpx;line-height:1.6}.application-time{display:block;margin-top:9rpx}.member-submit{margin-top:20rpx}.promotion-empty{min-height:150rpx}.empty-button{width:230rpx;min-height:76rpx;margin-top:28rpx;font-size:25rpx}
