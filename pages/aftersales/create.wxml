<view class="page-shell aftersales-page"><view class="page-heading"><text class="eyebrow">售后服务</text><text class="page-title">申请售后</text><text class="page-subtitle">订单：{{orderId}}</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在提交售后申请</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="submit">重新提交</view></view><view wx:elif="{{submitted}}" class="surface done-card"><text class="done-mark">✓</text><text class="done-title">申请已提交</text><text class="done-copy">当前状态：{{result.statusText || result.status || '待审核'}}。客服会在后台处理并通过微信消息提醒进展。</text><view class="secondary-button done-button" bindtap="back">返回订单</view></view><view wx:else class="surface form-card"><text class="field-label">售后原因</text><picker range="{{reasons}}" bindchange="reasonChange"><view class="picker-row"><text wx:if="{{reason}}">{{reason}}</text><text wx:else class="muted">请选择原因</text><text>⌄</text></view></picker><text class="field-label">补充说明</text><textarea class="form-textarea" data-field="note" bindinput="input" placeholder="请描述问题，便于客服处理" /><view class="secondary-button upload-button" bindtap="chooseImage">{{filePath ? '已选择图片' : '＋ 添加图片'}}</view><view class="primary-button submit-button" bindtap="submit">提交售后申请</view></view></view>

