<view class="page-shell sales-sub-page" data-route="/pages/sales/withdrawals" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : rows.length ? 'ready' : 'empty'}}"><view class="page-heading"><text class="eyebrow">销售中心 / 提现</text><text class="page-title">提现记录</text><text class="page-subtitle">提现申请由后台审核，打款状态会持续更新。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载提现记录</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view><view wx:else class="surface sales-sub-list"><view wx:for="{{rows}}" wx:key="id" class="performance-row"><view><text>¥{{item.amountText}}</text><text class="muted">{{item.createdAt}}</text></view><text>{{item.statusText || item.status}}</text></view><view wx:if="{{!rows.length}}" class="empty-state"><text>暂无提现记录</text></view></view></view>
