<view class="page-shell sales-sub-page" data-route="/pages/sales/order-draft" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : confirming ? 'saving' : 'ready'}}"><view class="page-heading"><text class="eyebrow">代客订单</text><text class="page-title">确认订单</text><text class="page-subtitle">请确认收货地址，订单将由当前登录用户支付。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载订单</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text></view><view wx:else><view class="surface draft-card"><text class="block-title">商品清单</text><view wx:for="{{draft.items}}" wx:key="productId" class="performance-row"><text>{{item.name}} × {{item.quantity}}</text><text>¥{{item.totalText}}</text></view></view><view class="surface draft-card" bindtap="chooseAddress"><text class="block-title">收货地址</text><text wx:if="{{address}}">{{address.name}} {{address.phone}} · {{address.detail}}</text><text wx:else>请选择收货地址 ›</text></view><view class="primary-button" bindtap="confirm">{{confirming ? '确认中…' : '确认地址并进入支付'}}</view></view></view>
