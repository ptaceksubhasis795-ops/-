<view class="page-shell sales-sub-page" data-route="/pages/sales/customers" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : customers.length ? 'ready' : 'empty'}}"><view class="page-heading"><text class="eyebrow">销售中心 / 客户</text><text class="page-title">直接客户</text><text class="page-subtitle">查看长期归属客户和最近购买记录。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载客户</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="retry">重新加载</view><view class="primary-button empty-button" bindtap="openLogin">去登录</view></view><view wx:else class="surface sales-sub-list"><view wx:for="{{customers}}" wx:key="id" class="sales-sub-row"><view class="customer-avatar">{{item.initial}}</view><view class="sales-sub-copy"><text>{{item.name}}</text><text class="muted">{{item.lastOrder || '暂无购买记录'}}</text></view><text class="customer-amount">¥{{item.amountText}}</text></view><view wx:if="{{!customers.length}}" class="empty-state"><text>暂无直接客户</text></view></view></view>
