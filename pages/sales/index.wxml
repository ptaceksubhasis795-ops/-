<view class="page-shell sales-page" data-route="/pages/sales/index" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : 'ready'}}">
  <view wx:if="{{loading}}" class="surface empty-state"><text>正在加载销售数据</text></view>
  <view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="onShow">重新加载</view><view class="secondary-button empty-button" bindtap="applyMember">申请会员</view></view>
  <view wx:elif="{{user}}">
  <view class="sales-hero"><view class="sales-hero-top"><text class="eyebrow">销售中心</text><text class="sales-mark">九转</text></view><text class="sales-title">把服务分享给更多人</text><view class="sales-balance"><text class="balance-label">可提现奖励</text><text class="balance-value">¥{{user.rewardBalanceText}}</text></view><view class="sales-actions"><view class="sales-action" bindtap="showWithdraw"><text>申请提现</text><text>→</text></view><view class="sales-action" bindtap="applyMember"><text>会员规则</text><text>↗</text></view></view></view>
  <view class="promo-tools surface"><view class="promo-tools-head"><view><text class="section-kicker">推广素材</text><text class="block-title">推广素材</text></view><text class="muted">专属归属已绑定</text></view><view class="promo-actions"><view class="promo-action" bindtap="copyShareLink"><text class="promo-icon">链</text><text>复制链接</text></view><view class="promo-action" bindtap="poster"><text class="promo-icon">海</text><text>推广素材</text></view><button class="promo-action" open-type="share"><text class="promo-icon">享</text><text>立即分享</text></button><view class="promo-action" bindtap="openNetwork"><text class="promo-icon">树</text><text>我的关系</text></view><view wx:if="{{user.role === 'SALES' || user.role === 'sales'}}" class="promo-action" bindtap="openAgentOrder"><text class="promo-icon">单</text><text>代客下单</text></view></view></view>
  <view class="metrics"><view class="surface metric-card" bindtap="openCustomers"><text class="metric-label">直接客户</text><text class="metric-value">{{user.customerCount || 0}}</text><text class="metric-hint">长期归属</text></view><view class="surface metric-card" bindtap="openPerformance"><text class="metric-label">累计业绩</text><text class="metric-value">¥{{performanceAmountText}}</text><text class="metric-hint">含运费业绩</text></view><view class="surface metric-card" bindtap="openRewards"><text class="metric-label">待生效</text><text class="metric-value">¥{{pendingAmountText}}</text><text class="metric-hint">收货后结算</text></view></view>
  <view class="section-heading"><text class="section-heading__title">直接客户</text><text class="section-heading__action" bindtap="openCustomers">查看全部 ›</text></view><view class="surface customer-list"><view wx:for="{{customers}}" wx:key="name" class="customer-row"><view class="customer-avatar">{{item.initial}}</view><view class="customer-copy"><text>{{item.name}}</text><text class="muted">最近购买：{{item.source}}</text></view><text class="customer-amount">{{item.amount}}</text></view></view>
  <view class="section-heading"><text class="section-heading__title">奖励明细</text><text class="section-heading__action" bindtap="openRewards">每周一结算 ›</text></view><view class="surface commission-list"><view wx:for="{{commission}}" wx:key="id" class="commission-row"><view><text class="commission-source">{{item.source}}</text><text class="muted">{{item.date}} · {{item.status}}</text></view><text class="commission-amount">+¥{{item.amountText}}</text></view></view>
  <view wx:if="{{showWithdraw}}" class="modal-mask"><view class="withdraw-modal"><text class="modal-kicker">提现申请</text><text class="modal-title">申请提现</text><text class="modal-copy">可提现余额达到 500 元后提交，后台审核后通过微信商家转账打款。</text><input class="withdraw-input" type="digit" placeholder="请输入提现金额" value="{{withdrawAmount}}" bindinput="input" /><view class="modal-actions"><view class="secondary-button" bindtap="closeWithdraw">取消</view><view class="primary-button" bindtap="withdraw">提交申请</view></view></view></view>
  </view>
</view>

