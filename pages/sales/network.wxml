<view class="page-shell sales-sub-page" data-route="/pages/sales/network" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : network ? 'ready' : 'empty'}}">
  <view class="page-heading"><text class="eyebrow">销售中心 / 关系</text><text class="page-title">我的关系</text><text class="page-subtitle">只展示当前账号有权限查看的上级、下属和客户，联系方式已经脱敏。</text></view>
  <view wx:if="{{loading}}" class="surface empty-state"><text>正在加载关系</text></view>
  <view wx:elif="{{errorMessage && authRequired}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view>
  <view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view>
  <view wx:else>
    <view wx:if="{{network.promoter}}" class="surface identity-card"><text class="card-label">当前身份</text><view class="identity-line"><view><text class="card-title">{{network.promoter.name}}</text><text class="muted">{{roleText}}</text></view><text class="status-pill">已启用</text></view></view>
    <view wx:else class="surface empty-state relationship-empty"><text>当前账号还没有会员推广档案</text><view class="primary-button empty-button" bindtap="openMemberApply">申请成为会员</view></view>
    <view wx:if="{{superior}}" class="surface network-section"><text class="section-heading__title">我的上级销售人员</text><view class="person-row"><view class="person-avatar">{{superior.name}}</view><view class="person-copy"><text>{{superior.name}}</text><text class="muted">{{superior.classText}}</text></view></view></view>
    <view wx:if="{{isSales}}" class="surface network-section"><view class="section-heading-inline"><text class="section-heading__title">下属会员</text><text class="count-text">{{members.length}} 人</text></view><view wx:for="{{members}}" wx:key="id" class="person-row"><view class="person-avatar">{{item.name}}</view><view class="person-copy"><text>{{item.name}}</text><text class="muted">{{item.classText}}</text></view></view><view wx:if="{{!hasMembers}}" class="section-empty"><text>暂无下属会员</text></view></view>
    <view wx:if="{{isSales}}" class="surface network-section"><view class="section-heading-inline"><text class="section-heading__title">下属销售人员</text><text class="count-text">{{sales.length}} 人</text></view><view wx:for="{{sales}}" wx:key="id" class="person-row"><view class="person-avatar sales-avatar">{{item.name}}</view><view class="person-copy"><text>{{item.name}}</text><text class="muted">{{item.classText}}</text></view></view><view wx:if="{{!hasSales}}" class="section-empty"><text>暂无下属销售人员</text></view></view>
    <view class="surface network-section"><view class="section-heading-inline"><text class="section-heading__title">{{isSales ? '团队客户' : '我的客户'}}</text><text class="count-text">{{customers.length}} 人</text></view><view wx:for="{{customers}}" wx:key="id" class="customer-row"><view class="person-avatar customer-avatar">{{item.initial}}</view><view class="person-copy"><text>{{item.name}}</text><text class="muted">{{item.phoneMasked}} · {{item.lastOrderText}}</text></view><text class="customer-amount">¥{{item.amountText}}</text></view><view wx:if="{{!hasCustomers}}" class="section-empty"><text>{{isSales ? '暂无团队客户' : '暂无直接客户'}}</text></view></view>
  </view>
</view>
