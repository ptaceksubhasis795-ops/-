.sales-sub-page { padding-bottom: 50rpx; }.sales-sub-list { padding: 0 22rpx; }.sales-sub-row { display: flex; align-items: center; min-height: 112rpx; border-bottom: 1rpx solid #e6efeb; }.sales-sub-row:last-child { border-bottom: 0; }.customer-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 18rpx; border-radius: 22rpx; background: #dcefea; color: #286f67; font-size: 28rpx; }.sales-sub-copy { display: flex; flex: 1; flex-direction: column; gap: 8rpx; }.sales-sub-copy text:first-child { color: #31514d; font-size: 27rpx; }.sales-sub-copy .muted { font-size: 22rpx; }.customer-amount { color: #bd6a28; font-size: 25rpx; font-weight: 700; }
