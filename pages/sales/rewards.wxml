<view class="page-shell sales-sub-page" data-route="/pages/sales/rewards" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : rows.length ? 'ready' : 'empty'}}"><view class="page-heading"><text class="eyebrow">销售中心 / 奖励</text><text class="page-title">奖励台账</text><text class="page-subtitle">收货后 7 天无售后，奖励进入可结算状态。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载奖励</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view><view wx:else class="surface sales-sub-list"><view wx:for="{{rows}}" wx:key="id" class="performance-row"><view><text>{{item.source || item.orderId}}</text><text class="muted">{{item.statusText || item.status}} · {{item.date}}</text></view><text>¥{{item.amountText}}</text></view><view wx:if="{{!rows.length}}" class="empty-state"><text>暂无奖励记录</text></view></view></view>
