.sales-sub-page { padding-bottom: 50rpx; }.performance-total { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 28rpx; color: #37645d; font-size: 27rpx; }.performance-total text:last-child { color: #bd6a28; font-size: 40rpx; font-weight: 700; }.sales-sub-list { padding: 0 22rpx; }.performance-row { display: flex; align-items: center; justify-content: space-between; min-height: 100rpx; border-bottom: 1rpx solid #e6efeb; color: #31514d; font-size: 25rpx; }.performance-row view { display: flex; flex-direction: column; gap: 7rpx; }.performance-row > text:last-child { color: #bd6a28; font-weight: 700; }
