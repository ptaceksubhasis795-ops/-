<view class="page-shell sales-sub-page" data-route="/pages/sales/order-create" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : submitting ? 'saving' : draft ? 'success' : 'ready'}}"><view class="page-heading"><text class="eyebrow">销售中心 / 代客下单</text><text class="page-title">创建普通商品订单</text><text class="page-subtitle">销售只创建草稿，客户确认地址并本人支付。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载客户和商品</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text></view><view wx:else class="surface order-form"><text class="field-label">客户</text><picker mode="selector" range="{{customers}}" range-key="name" value="{{customerIndex}}" bindchange="customerChange"><view class="picker-field">{{customers[customerIndex].name || '请选择客户'}} ›</view></picker><text class="field-label">普通商品</text><picker mode="selector" range="{{products}}" range-key="name" value="{{productIndex}}" bindchange="productChange"><view class="picker-field">{{products[productIndex].name || '请选择商品'}} ›</view></picker><text class="field-label">数量</text><input class="form-input" type="number" value="{{quantity}}" bindinput="quantityChange" /><view class="primary-button" bindtap="create">{{submitting ? '创建中…' : '创建订单草稿并复制链接'}}</view><view wx:if="{{draft}}" class="draft-result">草稿已创建，客户打开链接后确认地址并支付。</view></view></view>
