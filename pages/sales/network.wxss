.sales-sub-page{padding-bottom:50rpx}.identity-card,.network-section{margin-bottom:20rpx;padding:28rpx}.card-label,.section-heading__title{display:block;color:#6c8f89;font-size:24rpx}.card-title{display:block;margin:12rpx 0 6rpx;color:#1d4b47;font-size:38rpx;font-weight:600}.identity-line,.section-heading-inline{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.status-pill{display:inline-flex;align-items:center;padding:9rpx 15rpx;border-radius:18rpx;background:#e3f5ef;color:#0f766e;font-size:21rpx;white-space:nowrap}.count-text{color:#93a5a0;font-size:21rpx}.person-row,.customer-row{display:flex;align-items:center;min-height:100rpx;padding:18rpx 0;border-bottom:1rpx solid #e5efec}.person-row:last-child,.customer-row:last-child{border-bottom:0}.person-avatar{display:flex;align-items:center;justify-content:center;flex:none;width:62rpx;height:62rpx;border-radius:21rpx;background:#e3f5ef;color:#0f766e;font-size:22rpx;font-weight:700}.sales-avatar{background:#f5eff8;color:#725481}.customer-avatar{background:#fff0dc;color:#b7682e}.person-copy{display:flex;flex:1;flex-direction:column;gap:6rpx;padding-left:16rpx;color:#315a55;font-size:27rpx}.customer-amount{color:#bd6a28;font-size:24rpx;font-weight:700}.section-empty{display:flex;align-items:center;justify-content:center;min-height:110rpx;color:#93a5a0;font-size:24rpx}.relationship-empty{min-height:250rpx}.empty-button{width:230rpx;min-height:76rpx;margin-top:28rpx;font-size:25rpx}
