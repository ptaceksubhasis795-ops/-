<view class="page-shell sales-sub-page" data-route="/pages/sales/performance" data-visual-state="{{loading ? 'loading' : errorMessage ? 'error' : rows.length ? 'ready' : 'empty'}}"><view class="page-heading"><text class="eyebrow">销售中心 / 业绩</text><text class="page-title">销售业绩</text><text class="page-subtitle">业绩金额含运费，奖励金额按商品实付金额计算。</text></view><view class="surface performance-total"><text>累计业绩</text><text>¥{{total}}</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载业绩</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view><view wx:else class="surface sales-sub-list"><view wx:for="{{rows}}" wx:key="id" class="performance-row"><view><text>{{item.orderId}}</text><text class="muted">{{item.period}} · {{item.selfPurchaseText}}</text></view><text>¥{{item.amountText}}</text></view><view wx:if="{{!rows.length}}" class="empty-state"><text>暂无业绩记录</text></view></view></view>
