<view class="page-shell profile-page {{largeText ? 'large-text' : ''}}">
  <view wx:if="{{loading}}" class="surface empty-state"><text>正在加载个人信息</text></view>
  <view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="onShow">重新加载</view></view>
  <view wx:elif="{{user}}">
  <view class="profile-hero" bindtap="openLogin"><view class="profile-avatar">{{user.initial || '我'}}</view><view class="profile-copy"><text class="profile-name">{{user.nickname}}</text><text class="profile-phone">{{user.phone || '登录后同步你的健康记录'}}</text><text class="member-pill">{{user.memberLevel || '普通会员'}} · 九转健康用户</text></view><text class="profile-edit">↗</text></view>
  <view class="surface quick-summary"><view class="summary-item"><text class="summary-value">{{pendingOrderCount}}</text><text class="summary-label">待处理订单</text></view><view class="summary-divider"></view><view class="summary-item"><text class="summary-value">{{prescriptionCount}}</text><text class="summary-label">我的处方</text></view><view class="summary-divider"></view><view class="summary-item"><text class="summary-value">{{unread}}</text><text class="summary-label">消息提醒</text></view></view>
  <view class="section-heading"><text class="section-heading__title">我的服务</text><text class="section-heading__action">全部服务</text></view>
  <view class="surface service-list"><view class="service-row" bindtap="open" data-target="orders"><text class="service-icon">单</text><view class="service-copy"><text class="service-name">我的订单</text><text class="service-hint">查看支付、物流和售后</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="prescriptions"><text class="service-icon">处</text><view class="service-copy"><text class="service-name">我的处方</text><text class="service-hint">审核状态与有效期</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="patients"><text class="service-icon">人</text><view class="service-copy"><text class="service-name">就诊人管理</text><text class="service-hint">实名信息与过敏史</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="cart"><text class="service-icon">袋</text><view class="service-copy"><text class="service-name">购物袋</text><text class="service-hint">准备好的商品</text></view><text class="service-arrow">→</text></view></view>
  <view class="section-heading"><text class="section-heading__title">推广与内容</text><text class="section-heading__action">探索更多</text></view>
  <view class="surface service-list"><view class="service-row" bindtap="open" data-target="member"><text class="service-icon warm">会</text><view class="service-copy"><text class="service-name">申请成为会员</text><text class="service-hint">分享内容，获得长期奖励</text></view><text class="service-arrow">→</text></view><view wx:if="{{user.role === 'MEMBER' || user.role === 'member' || user.memberLevel === 'SENIOR_MEMBER'}}" class="service-row" bindtap="open" data-target="promotion"><text class="service-icon warm">升</text><view class="service-copy"><text class="service-name">会员晋升申请</text><text class="service-hint">查看业绩条件和审批状态</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="network"><text class="service-icon warm">树</text><view class="service-copy"><text class="service-name">我的关系</text><text class="service-hint">查看上级、下属会员和客户</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="sales"><text class="service-icon warm">奖</text><view class="service-copy"><text class="service-name">销售中心与奖励</text><text class="service-hint">客户、素材和可提现余额</text></view><text class="service-arrow">→</text></view><view class="service-row" bindtap="open" data-target="articles"><text class="service-icon warm">知</text><view class="service-copy"><text class="service-name">健康科普</text><text class="service-hint">把专业内容讲清楚</text></view><text class="service-arrow">→</text></view><view class="service-row setting-row"><text class="service-icon warm">字</text><view class="service-copy"><text class="service-name">大字模式</text><text class="service-hint">提升阅读舒适度</text></view><switch checked="{{largeText}}" color="#0D7F75" bindchange="toggleLargeText" /></view></view>
  <view class="profile-note"><text>身份证、健康信息和处方文件均按权限保护</text></view>
  </view>
</view>
