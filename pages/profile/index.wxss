.profile-page { padding-bottom: 70rpx; }
.profile-hero { position: relative; display: flex; align-items: center; overflow: hidden; padding: 30rpx 24rpx; border-radius: 29rpx; background: #0b706a; color: #fff; box-shadow: 0 15rpx 35rpx rgba(11,112,106,.18); }
.profile-hero::after { position: absolute; right: -70rpx; bottom: -130rpx; width: 300rpx; height: 300rpx; border: 2rpx solid rgba(255,255,255,.18); border-radius: 50%; content: ""; }
.profile-avatar { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; flex: none; width: 94rpx; height: 94rpx; border: 2rpx solid rgba(255,255,255,.64); border-radius: 31rpx; background: rgba(255,255,255,.12); font-family: "Noto Serif SC", "Songti SC", serif; font-size: 37rpx; font-weight: 700; }
.profile-copy { position: relative; z-index: 1; display: flex; flex: 1; flex-direction: column; padding-left: 19rpx; }
.profile-name { font-size: 32rpx; font-weight: 700; }
.profile-phone { margin-top: 9rpx; color: #ccece8; font-size: 22rpx; }
.member-pill { align-self: flex-start; margin-top: 13rpx; padding: 6rpx 10rpx; border: 1rpx solid rgba(255,255,255,.28); border-radius: 9rpx; color: #dff6f1; font-size: 17rpx; }
.profile-edit { position: relative; z-index: 1; color: #ccece8; font-size: 31rpx; }
.quick-summary { display: flex; align-items: center; margin-top: 18rpx; padding: 22rpx 8rpx; }
.summary-item { display: flex; align-items: center; flex: 1; flex-direction: column; }
.summary-value { color: #0d7f75; font-size: 33rpx; font-weight: 700; }
.summary-label { margin-top: 7rpx; color: #71827e; font-size: 21rpx; }
.summary-divider { width: 1rpx; height: 49rpx; background: #e4eeeb; }
.service-list { padding: 0 23rpx; }
.service-row { display: flex; align-items: center; min-height: 107rpx; }
.service-row + .service-row { border-top: 1rpx solid #e7efec; }
.service-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 54rpx; height: 54rpx; border: 2rpx solid #c9e2dc; border-radius: 17rpx; background: #edf8f5; color: #0d7f75; font-family: "Noto Serif SC", "Songti SC", serif; font-size: 22rpx; font-weight: 700; }
.service-icon.warm { border-color: #f0d6b4; background: #fff5e8; color: #b7682e; }
.service-copy { display: flex; flex: 1; flex-direction: column; padding-left: 17rpx; }
.service-name { color: #334643; font-size: 25rpx; }
.service-hint { margin-top: 6rpx; color: #9aa9a5; font-size: 19rpx; }
.service-arrow { color: #8da09b; font-size: 26rpx; }
.setting-row switch { transform: scale(.84); transform-origin: right center; }
.profile-note { display: flex; align-items: center; flex-direction: column; gap: 6rpx; margin: 30rpx 8rpx 0; color: #9aa9a5; font-size: 19rpx; line-height: 1.5; text-align: center; }
.large-text .profile-name { font-size: 38rpx; }
.large-text .service-name, .large-text .summary-label { font-size: 29rpx; }
.large-text .profile-note { font-size: 24rpx; }
