.cart-page { padding-bottom: 60rpx; }
.cart-row { position: relative; display: flex; align-items: center; min-height: 190rpx; margin-bottom: 18rpx; padding: 22rpx; }
.cart-thumb { flex: none; width: 142rpx; height: 142rpx; border-radius: 20rpx; }
.cart-copy { display: flex; flex: 1; flex-direction: column; padding: 0 34rpx 0 22rpx; }
.cart-name { color: #22312f; font-size: 28rpx; font-weight: 700; }
.cart-meta { margin-top: 11rpx; color: #94a5a0; font-size: 21rpx; }
.cart-price { margin-top: 21rpx; color: #bd6a28; font-size: 30rpx; font-weight: 700; }
.cart-remove { position: absolute; top: 17rpx; right: 24rpx; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #f1f6f4; color: #94a5a0; font-size: 30rpx; }
.cart-empty { min-height: 470rpx; }
.empty-copy { margin-top: 12rpx; color: #a0afab; font-size: 21rpx; }
.cart-summary { margin-top: 24rpx; padding: 24rpx 26rpx 26rpx; }
.shipping-hint { display: flex; align-items: center; margin-bottom: 24rpx; padding: 16rpx 17rpx; border-radius: 16rpx; background: #eef8f5; color: #4c7770; font-size: 20rpx; }
.shipping-icon { display: flex; align-items: center; justify-content: center; width: 35rpx; height: 35rpx; margin-right: 9rpx; border-radius: 12rpx; background: #d8eee8; color: #0d7f75; font-size: 18rpx; }
.summary-line, .summary-total { display: flex; justify-content: space-between; color: #71827e; font-size: 23rpx; }
.summary-line + .summary-line { margin-top: 15rpx; }
.summary-total { margin-top: 24rpx; padding-top: 21rpx; border-top: 1rpx solid #e7efec; color: #22312f; font-size: 30rpx; font-weight: 700; }
.summary-total text:last-child { color: #bd6a28; }
.cart-checkout { margin-top: 25rpx; }
.checkout-arrow { margin-left: 9rpx; font-size: 28rpx; }
