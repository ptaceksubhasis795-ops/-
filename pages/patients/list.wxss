.patients-page { padding-bottom: 64rpx; }
.page-heading { margin-bottom: 28rpx; }
.eyebrow { display: block; color: #0f766e; font-size: 19rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 8rpx; color: #111827; font-size: 42rpx; font-weight: 700; }
.page-subtitle { display: block; margin-top: 14rpx; color: #64748b; font-size: 23rpx; line-height: 1.5; }
.patient-card { display: flex; align-items: center; margin-bottom: 18rpx; padding: 24rpx; }
.patient-avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; background: #e6f4f1; color: #0f766e; font-size: 30rpx; font-weight: 700; }
.patient-copy { display: flex; flex: 1; flex-direction: column; padding-left: 20rpx; }
.patient-head { display: flex; align-items: baseline; }
.patient-name { color: #1f2937; font-size: 29rpx; font-weight: 700; }
.patient-relation { margin-left: 12rpx; color: #0f766e; font-size: 20rpx; }
.patient-meta { margin-top: 9rpx; color: #94a3b8; font-size: 21rpx; }
.patient-arrow { color: #94a3b8; font-size: 38rpx; }
.add-button { margin-top: 24rpx; }
