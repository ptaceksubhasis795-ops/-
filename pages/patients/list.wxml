<view class="page-shell patients-page"><view class="page-heading"><text class="eyebrow">就诊人管理</text><text class="page-title">就诊人</text><text class="page-subtitle">处方商品需要实名就诊人，支持添加家人。</text></view><view wx:if="{{loading}}" class="surface empty-state"><text>正在加载就诊人</text></view><view wx:elif="{{errorMessage}}" class="surface empty-state"><text>{{errorMessage}}</text><view class="primary-button empty-button" bindtap="openLogin">去登录</view><view class="secondary-button empty-button" bindtap="retry">重新加载</view></view><view wx:else><view wx:for="{{patients}}" wx:key="id" class="surface patient-card" bindtap="edit" data-id="{{item.id}}"><view class="patient-avatar">{{item.relation === '本人' ? '我' : '家'}}</view><view class="patient-copy"><view class="patient-head"><text class="patient-name">{{item.name}}</text><text class="patient-relation">{{item.relation}}</text></view><text class="patient-meta">身份证 {{item.maskedId}}</text><text class="patient-meta">手机号 {{item.phone}}</text></view><text class="patient-arrow">›</text></view><view wx:if="{{!patients.length}}" class="surface empty-state"><text>还没有就诊人</text></view><view class="secondary-button add-button" bindtap="add">＋ 添加就诊人</view></view></view>

